{
  "name": "@planet-producciones/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema VIP de Cotizaciones Planet Producciones 2026 — Frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:institucional": "vite --config vite.config.institucional.ts",
    "build:institucional": "tsc -p institucional/tsconfig.json --noEmit && vite build --config vite.config.institucional.ts",
    "build:institucional:borrador": "tsc -p institucional/tsconfig.json --noEmit && vite build --config vite.config.institucional.ts --mode borrador",
    "preview:institucional": "vite preview --config vite.config.institucional.ts",
    "typecheck:institucional": "tsc -p institucional/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
