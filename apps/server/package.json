{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@my-app/api": "*",
    "@my-app/db": "*",
    "@my-app/env": "*",
    "@pothos/core": "^4.13.1",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.22.0",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@my-app/config": "*",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "jsdom": "^29.1.1",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  },
  "trustedDependencies": [
    "supabase"
  ]
