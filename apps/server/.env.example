PORT=3000
# Debe coincidir con el proveedor real de EMAIL_USER ('gmail', 'hotmail', etc.)
EMAIL_SERVICE=gmail
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_password_de_aplicacion
# Aviso de nueva cotización recibida (apps/server/src/routes/cotizaciones.routes.ts)
EMAIL_JEFE=correo_destino_gerencia@example.com
# Aviso de nuevo PQRS recibido (apps/server/src/routes/pqrs.routes.ts)
EMAIL_SECRETARIA=correo_destino_secretaria@example.com
# Copia del contrato enviado al cliente (si no está, se usa el correo real de la
# cuenta con rol administrador en profiles.correo)
EMAIL_ADMINISTRADOR=correo_destino_administradora@example.com

# Base de datos (Postgres de Supabase, "Planet Producciones DB")
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Proyecto de Supabase (Project Settings -> API) - para Supabase Auth, no para Postgres
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Autenticación de los paneles internos (cookie de sesión propia)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Origen del frontend permitido para cookies de sesión (CORS)
WEB_ORIGIN=http://localhost:5173

# Seguridad del correo: el certificado de Gmail se verifica siempre. Si tu red lo intercepta
# (error "self-signed certificate in certificate chain"), elige UNA de estas opciones:
#   EMAIL_CA_FILE=C:/ruta/al/certificado-raiz-del-antivirus.pem   (recomendada)
#   EMAIL_TLS_INSECURE=true                                        (solo desarrollo)

# Carpeta de los contratos firmados. En producción debe ser un disco/volumen persistente
# (docker-compose.yml ya monta uno en /app/uploads).
# UPLOADS_DIR=/app/uploads
