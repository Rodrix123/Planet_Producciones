PORT=3000
EMAIL_USER=tu_correo@outlook.com
EMAIL_PASS=tu_password_de_aplicacion

# Correos de la empresa que reciben cada cotización generada (PDF + Excel).
# Un solo correo por variable; las que queden vacías no reciben la cotización.
EMAIL_SECRETARIA=correo_secretaria@example.com
EMAIL_JEFE=correo_destino_gerencia@example.com
EMAIL_ADMINISTRADOR=correo_administrador@example.com

# WhatsApp Cloud API (Meta) - envío automático de cotizaciones a la dueña
WHATSAPP_TOKEN=tu_token_de_acceso_permanente_de_meta
WHATSAPP_PHONE_NUMBER_ID=id_del_numero_de_whatsapp_business
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DUENA_NUMERO=573001234567
