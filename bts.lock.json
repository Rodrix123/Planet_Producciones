    "apps/server/package.json": "{\n  \"name\": \"server\",\n  \"main\": \"src/index.ts\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsdown\",\n    \"check-types\": \"tsc -b\",\n    \"compile\": \"bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server\",\n    \"test\": \"vitest run --passWithNoTests\",\n    \"dev\": \"tsx watch src/index.ts\",\n    \"start\": \"node dist/index.js\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"^17.4.2\",\n    \"zod\": \"^4.4.3\",\n    \"@my-app/env\": \"*\",\n    \"@my-app/api\": \"*\",\n    \"hono\": \"^4.12.27\",\n    \"@hono/node-server\": \"^2.1.1\",\n    \"graphql-yoga\": \"^5.22.0\",\n    \"graphql\": \"^16.11.0\",\n    \"@pothos/core\": \"^4.13.1\",\n    \"@supabase/supabase-js\": \"^2.112.3\",\n    \"@my-app/db\": \"*\"\n  },\n  \"trustedDependencies\": [\n    \"supabase\"\n  ],\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"tsdown\": \"^0.22.3\",\n    \"@my-app/config\": \"*\",\n    \"tsx\": \"^4.23.12\",\n    \"@types/node\": \"^26.2.0\",\n    \"vitest\": \"4.1.8\",\n    \"@vitest/ui\": \"4.1.8\",\n    \"@vitest/coverage-v8\": \"4.1.8\",\n    \"jsdom\": \"^29.1.1\"\n  }\n}\n",
    "apps/web/package.json": "{\n  \"name\": \"web\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"check-types\": \"tsc --noEmit\",\n    \"dev\": \"vite dev\",\n    \"build\": \"tsc --noEmit && vite build\",\n    \"serve\": \"vite preview\",\n    \"test\": \"vitest run --passWithNoTests\",\n    \"codegen\": \"graphql-codegen --config codegen.ts\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"^17.4.2\",\n    \"zod\": \"^4.4.3\",\n    \"@my-app/env\": \"*\",\n    \"@my-app/api\": \"*\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^26.2.0\",\n    \"@tailwindcss/vite\": \"^4.3.3\",\n    \"tailwindcss\": \"^4.3.3\",\n    \"typescript\": \"^5\",\n    \"vite\": \"^8.2.2\",\n    \"@my-app/config\": \"*\",\n    \"@graphql-codegen/cli\": \"^7.3.0\",\n    \"@graphql-codegen/client-preset\": \"^6.1.3\",\n    \"graphql\": \"^16.11.0\",\n    \"vitest\": \"4.1.8\",\n    \"@vitest/ui\": \"4.1.8\",\n    \"@vitest/coverage-v8\": \"4.1.8\",\n    \"jsdom\": \"^29.1.1\",\n    \"daisyui\": \"^5.7.20\"\n  }\n}\n",
    "package.json": "{\n  \"name\": \"my-app\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"dev\": \"turbo dev\",\n    \"build\": \"turbo build\",\n    \"check-types\": \"turbo check-types\",\n    \"dev:web\": \"turbo -F web dev\",\n    \"dev:server\": \"turbo -F server dev\",\n    \"db:push\": \"turbo -F @my-app/db db:push\",\n    \"db:studio\": \"turbo -F @my-app/db db:studio\",\n    \"db:generate\": \"turbo -F @my-app/db db:generate\",\n    \"db:migrate\": \"turbo -F @my-app/db db:migrate\",\n    \"test\": \"npm run test --workspace web && npm run test --workspace server && npm run test --workspace @my-app/api\"\n  },\n  \"packageManager\": \"npm@10.9.2\",\n  \"overrides\": {\n    \"@vitejs/devtools\": \"0.4.1\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"^17.4.2\",\n    \"zod\": \"^4.4.3\",\n    \"@my-app/env\": \"*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"@types/node\": \"^26.2.0\",\n    \"@my-app/config\": \"*\",\n    \"turbo\": \"2.10.11\"\n  }\n}\n",
